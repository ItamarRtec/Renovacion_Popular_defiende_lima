NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# REQUERIDO en el servidor: registro (/api/registro), magic-link, event-login
# y promoción de roles (/admin1010 → /api/ops/promote). Nunca exponer en el
# navegador ni en git. Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Clave del admin secreto (/admin1010). Elige una cadena larga y aleatoria.
# Sin este valor, la promoción de roles responde 503.
ADMIN_PROMOTE_SECRET=

# Cloudflare Turnstile (CAPTCHA del acceso de personeros). REQUERIDO para el
# evento: sin el secret, el CAPTCHA se OMITE (solo válido en desarrollo).
# Crea las claves en https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp de asignación (Rafael López Aliga / Defiende Lima).
# 9 dígitos Perú o E.164 sin "+": 51987654321
NEXT_PUBLIC_WHATSAPP_RAFAEL=

# Robot ONPE (tools/onpe-consulta). Server-only: al registrar, consulta
# mesa/ubigeo por DNI. Si falta, el registro sigue sin mesa.
# Local: cd tools/onpe-consulta && npm start  →  http://127.0.0.1:8787
ONPE_CONSULTA_URL=http://127.0.0.1:8787
# Solo si el robot no está en loopback (mismo valor que CONSULTA_TOKEN allá)
ONPE_CONSULTA_TOKEN=
