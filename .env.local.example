NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# REQUERIDO en el servidor: registro (/api/registro), magic-link, event-login
# y promoción de roles (/admin1010 → /api/ops/promote). Nunca exponer en el
# navegador ni en git. Dashboard → Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=

# Login del panel en /admin1010 (tabla public.administradores).
# Primera vez: si la tabla está vacía, se crea el primer admin con estos valores.
# Opcional: ADMIN_SESSION_SECRET (firma cookie); si falta, usa ADMIN_GATE_PASSWORD.
ADMIN_GATE_USER=
ADMIN_GATE_PASSWORD=
# ADMIN_SESSION_SECRET=

# Clave ops para promoción de roles (/admin/roles). Cadena larga y aleatoria.
# Sin este valor, la promoción responde 503.
ADMIN_PROMOTE_SECRET=

# Firma HMAC de los QR de asistencia (mín. 16 caracteres). Sin esto,
# /plataforma/qr queda desactivado. Nunca exponer al navegador.
CHECKIN_QR_SECRET=

# Panel /admin y /admin1010 solo en localhost por defecto.
# Pon 1 solo en una máquina de casa (p. ej. Tailscale), nunca en Vercel.
# ALLOW_ADMIN=1

# Objetivo de mesas a cubrir (Lima). Sin esto, "Mesas restantes" muestra —.
# ADMIN_MESAS_OBJETIVO=12000

# Cloudflare Turnstile (CAPTCHA del acceso de personeros). REQUERIDO en
# producción. En `npm run dev` / localhost se omite aunque estas claves existan.
# Crea las claves en https://dash.cloudflare.com → Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp de asignación (Rafael López Aliga / Defiende Lima).
# 9 dígitos Perú o E.164 sin "+": 51987654321
NEXT_PUBLIC_WHATSAPP_RAFAEL=

# Personero legal que aparece en la credencial impresa (opcional).
# Si falta el nombre, se muestra "Renovación Popular". No inventar un DNI.
# NEXT_PUBLIC_PERSONERO_LEGAL_NOMBRE=
# NEXT_PUBLIC_PERSONERO_LEGAL_DNI=
# NEXT_PUBLIC_PERSONERO_LEGAL_JEE=Lima

# Robot ONPE (tools/onpe-consulta). Server-only: al registrar, consulta
# mesa/ubigeo por DNI. Si falta, el registro sigue sin mesa.
# Local: cd tools/onpe-consulta && npm start  →  http://127.0.0.1:8787
ONPE_CONSULTA_URL=http://127.0.0.1:8787
# Solo si el robot no está en loopback (mismo valor que CONSULTA_TOKEN allá)
ONPE_CONSULTA_TOKEN=
